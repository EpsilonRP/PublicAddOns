<Bindings>
	<Binding category="Object Mover" name="Move Forward" header="OBJECTMANIP">
			OBJECT_TOOLBOX_API.MoveObject("forward")
	</Binding>
	<Binding category="Object Mover" name="Move Backward">
			OBJECT_TOOLBOX_API.MoveObject("back")
	</Binding>
	<Binding category="Object Mover" name="Move Left">
			OBJECT_TOOLBOX_API.MoveObject("left")
	</Binding>
	<Binding category="Object Mover" name="Move Right">
			OBJECT_TOOLBOX_API.MoveObject("right")
	</Binding>
	<Binding category="Object Mover" name="Move Up">
			OBJECT_TOOLBOX_API.MoveObject("up")
	</Binding>
	<Binding category="Object Mover" name="Move Down">
			OBJECT_TOOLBOX_API.MoveObject("down")
	</Binding>
	<Binding category="Object Mover" name="Get Object ID">
			OBJECT_TOOLBOX_API.GetObjectID()
	</Binding>

	<Binding category="Object Mover" name="Teleport to Object">
			OBJECT_TOOLBOX_API.Cmd("gobject go")
	</Binding>
	<Binding category="Object Mover" name="Spawn Object">
			OBJECT_TOOLBOX_API.SpawnGob(nil, "LeftButton")
	</Binding>
	<Binding category="Object Mover" name="Spawn Object with Scale/Rot/Color">
			OBJECT_TOOLBOX_API.SpawnGob(nil, "RightButton")
	</Binding>

	<Binding category="Object Mover" name="Toggle Move: World">
		ObjectToolboxFrame.ObjectMovementControls.Content.ModeToggles.world:Click()
	</Binding>
	<Binding category="Object Mover" name="Toggle Move: Relative">
		ObjectToolboxFrame.ObjectMovementControls.Content.ModeToggles.relative:Click()
	</Binding>
	<Binding category="Object Mover" name="Toggle Move: Copy">
		ObjectToolboxFrame.ObjectMovementControls.Content.AltModeToggles.copy:Click()
	</Binding>
	<Binding category="Object Mover" name="Toggle Move: Player">
		ObjectToolboxFrame.ObjectMovementControls.Content.AltModeToggles.player:Click()
	</Binding>


	<!--
	<Binding category="Object Mover" name="Toggle Scale">
			if OPScaleObjectToggle:IsEnabled() then OPScaleObjectToggle:SetChecked(not OPScaleObjectToggle:GetChecked()) end
	</Binding>
	-->

	<!---
	<Binding category="Object Mover" name="Toggle Spawn on Move">
		if not SpawnonMoveButton:IsEnabled() then return; end
			if SpawnonMoveButton:GetChecked() == true then
				SpawnonMoveButton:SetChecked(false)
				OPMasterTable.Options["SpawnOnMove"] = false
			else
				SpawnonMoveButton:SetChecked(true)
				OPMasterTable.Options["SpawnOnMove"] = true
			end
	</Binding>
	-->

	<Binding category="Object Mover" name="Show ObjectMover">
			SlashCmdList.OM_SHOWCLOSE()
	</Binding>

	<Binding category="Object Mover" name="Fence Builder: Mark Point">
			OBJECT_TOOLBOX_API.FenceBuilder.MarkPoint()
	</Binding>
	<Binding category="Object Mover" name="Fence Builder: Undo Last Point">
			OBJECT_TOOLBOX_API.FenceBuilder.UndoPoint()
	</Binding>
	<Binding category="Object Mover" name="Fence Builder: Toggle Window">
			OBJECT_TOOLBOX_API.FenceBuilder.Toggle()
	</Binding>
</Bindings>
